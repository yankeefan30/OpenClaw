#!/bin/bash
# rico-repair — LAN hop CLI for Rico 2.
#
# This is NOT an OpenClaw feature, plugin, second gateway, or iMessage path.
# It SSHes from Rico-2 to original Rico and runs allowlisted kit verbs only.
# No public bind. No cloud relay. No mail. No speaker.

set -euo pipefail

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(CDPATH= cd -- "${HERE}/.." && pwd)"
BUNDLED_KIT="${ROOT}/kit/rico-repair-kit.sh"
REMOTE_KIT="/Users/alan/Library/Scripts/rico-repair-kit.sh"

HOP_REQUIRED="Rico-2"
TARGET_USER="alan"
SSH_KEY="${RICO_REPAIR_SSH_KEY:-${HOME}/.ssh/rico2-to-rico}"
TARGETS=(192.168.4.118 Rico.local 100.98.73.107)
CONNECT_TIMEOUT=8
WATCH_INTERVAL=600
COOLDOWN_SECONDS=600

CONFIG_DIR="${HOME}/.config/rico-repair"
STATE_FILE="${CONFIG_DIR}/state"
LOCK_DIR="${CONFIG_DIR}/watch.lock"
LOG_FILE="${HOME}/Library/Logs/rico-repair.log"
ALERT_DIR="${HOME}/.local/state/rico-repair"
ALERT_FILE="${ALERT_DIR}/ALERT"
ALERT_LOG_COPY="${HOME}/Library/Logs/rico-repair-alert"
LAST_TARGET_FILE="${CONFIG_DIR}/last-target"

usage() {
  cat <<'EOF'
rico-repair — Rico 2 LAN hop (not OpenClaw, not iMessage)

Commands:
  status             Probe Rico over SSH (read + caffeinate-if-needed)
  restart-gateway    kickstart ai.openclaw.gateway on Rico only
  restart-grokbot    From Rico 2: restart pinned Grok Bot.app on Rico
  restart-grokbot-peer  From Rico: restart pinned Grok Bot.app on Rico 2
  restart-lmstudio   Reopen Bionic.app only if :1234 process is dead
  watch-once         One monitor tick (LaunchAgent, every 10 min)
  watch              Foreground 10-minute loop
  self-check         Local safety checks, no SSH

SSH targets in order: 192.168.4.118, Rico.local, 100.98.73.107
Key: ~/.ssh/rico2-to-rico  (BatchMode, IdentitiesOnly, ConnectTimeout 8)
EOF
  exit 2
}

is_test() {
  [ "${RICO_REPAIR_TEST:-}" = "1" ]
}

now_epoch() {
  /bin/date +%s
}

now_iso() {
  /bin/date -u +%Y-%m-%dT%H:%M:%SZ
}

log() {
  local line
  line="$(now_iso) $*"
  if is_test; then
    printf '%s\n' "$line" >&2
    return 0
  fi
  /bin/mkdir -p "$(dirname -- "$LOG_FILE")"
  printf '%s\n' "$line" >> "$LOG_FILE"
  printf '%s\n' "$line" >&2
}

die() {
  local rc="${2:-1}"
  log "error: $1"
  exit "$rc"
}

current_host() {
  if is_test; then
    printf '%s' "${RICO_REPAIR_TEST_HOP:-Rico-2}"
    return 0
  fi
  if [ ! -x /usr/sbin/scutil ]; then
    die "scutil missing; this hop is for macOS" 78
  fi
  /usr/sbin/scutil --get LocalHostName
}

require_hop_host() {
  local hn
  hn="$(current_host)"
  if [ "$hn" != "$HOP_REQUIRED" ]; then
    die "refuse: hop LocalHostName=${hn} (required: ${HOP_REQUIRED}). restart-grokbot runs on Rico-2. Use restart-grokbot-peer from original Rico." 78
  fi
}

require_origin_host() {
  local hn
  hn="$(current_host)"
  if [ "$hn" != "Rico" ]; then
    die "refuse: LocalHostName=${hn} (required: Rico). restart-grokbot-peer runs from original Rico only." 78
  fi
}

ensure_dirs() {
  /bin/mkdir -p "$CONFIG_DIR"
  /bin/chmod 700 "$CONFIG_DIR" 2>/dev/null || true
  /bin/mkdir -p "$ALERT_DIR"
  /bin/chmod 700 "$ALERT_DIR" 2>/dev/null || true
  /bin/mkdir -p "$(dirname -- "$LOG_FILE")"
}

write_alert() {
  local body="$1"
  ensure_dirs
  printf '%s\n' "$body" > "$ALERT_FILE"
  /bin/chmod 600 "$ALERT_FILE" 2>/dev/null || true
  printf '%s\n' "$body" > "$ALERT_LOG_COPY"
  /bin/chmod 600 "$ALERT_LOG_COPY" 2>/dev/null || true
  log "ALERT ${body}"
}

clear_alert() {
  /bin/rm -f "$ALERT_FILE" "$ALERT_LOG_COPY"
}

state_get() {
  local key="$1"
  if [ ! -f "$STATE_FILE" ]; then
    return 0
  fi
  /usr/bin/awk -F= -v key="$key" '$1==key {print substr($0, index($0,"=")+1); exit}' "$STATE_FILE"
}

state_set() {
  local key="$1"
  local value="$2"
  local tmp
  ensure_dirs
  tmp="${STATE_FILE}.tmp.$$"
  if [ -f "$STATE_FILE" ]; then
    /usr/bin/awk -F= -v key="$key" -v value="$value" '
      BEGIN { done=0 }
      $1==key { print key"="value; done=1; next }
      { print }
      END { if (!done) print key"="value }
    ' "$STATE_FILE" > "$tmp"
  else
    printf '%s=%s\n' "$key" "$value" > "$tmp"
  fi
  /bin/chmod 600 "$tmp"
  /bin/mv "$tmp" "$STATE_FILE"
}

cooldown_ok() {
  local action="$1"
  local last now
  last="$(state_get "cooldown_${action}")"
  now="$(now_epoch)"
  if [ -z "$last" ]; then
    return 0
  fi
  if [ $((now - last)) -ge "$COOLDOWN_SECONDS" ]; then
    return 0
  fi
  return 1
}

mark_cooldown() {
  local action="$1"
  state_set "cooldown_${action}" "$(now_epoch)"
  state_set "last_${action}_at" "$(now_iso)"
}

kv_get() {
  local blob="$1"
  local key="$2"
  printf '%s\n' "$blob" | /usr/bin/awk -F= -v key="$key" '$1==key {print substr($0, index($0,"=")+1); exit}'
}

fill_ssh_opts() {
  SSH_OPTS=(
    -i "$SSH_KEY"
    -o BatchMode=yes
    -o ConnectTimeout="${CONNECT_TIMEOUT}"
    -o IdentitiesOnly=yes
    -o PreferredAuthentications=publickey
    -o PasswordAuthentication=no
    -o KbdInteractiveAuthentication=no
    -o NumberOfPasswordPrompts=0
    -o ExitOnForwardFailure=yes
  )
}

require_key() {
  if [ ! -f "$SSH_KEY" ]; then
    die "SSH key missing: ${SSH_KEY}. Generate ed25519 with no passphrase (see README)." 75
  fi
}

allowlisted_verb() {
  case "$1" in
    identity|status|ensure-awake|probe-healthz|restart-gateway|probe-lmstudio|restart-lmstudio|grokbot-status|restart-grokbot|comms-state|disk)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

ssh_to() {
  local host="$1"
  shift
  fill_ssh_opts
  /usr/bin/ssh "${SSH_OPTS[@]}" "${TARGET_USER}@${host}" "$@"
}

record_target() {
  ensure_dirs
  printf '%s\n' "$1" > "$LAST_TARGET_FILE"
  /bin/chmod 600 "$LAST_TARGET_FILE" 2>/dev/null || true
  state_set last_target "$1"
}

rico_ssh_named_kit() {
  local verb="$1"
  local host rc=1 out=""
  for host in "${TARGETS[@]}"; do
    log "ssh ${host} kit ${verb}"
    if out="$(ssh_to "$host" "$REMOTE_KIT" "$verb" 2>&1)"; then
      record_target "$host"
      printf '%s\n' "$out"
      return 0
    fi
    rc=$?
    if printf '%s\n' "$out" | /usr/bin/grep -q 'result=wrong-host'; then
      log "remote hostname gate refused on ${host}"
      printf '%s\n' "$out"
      return 78
    fi
    if printf '%s\n' "$out" | /usr/bin/grep -q 'No such file or directory\|not found\|kit-missing'; then
      rc=127
      continue
    fi
    if [ "$rc" -eq 127 ] || [ "$rc" -eq 255 ]; then
      continue
    fi
    # Remote ran and failed the action; still a valid hop.
    record_target "$host"
    printf '%s\n' "$out"
    return "$rc"
  done
  return "$rc"
}

rico_ssh_piped_kit() {
  local verb="$1"
  local host rc=1 out=""
  if [ ! -f "$BUNDLED_KIT" ]; then
    return 127
  fi
  for host in "${TARGETS[@]}"; do
    log "ssh ${host} bundled-kit ${verb}"
    if out="$(ssh_to "$host" "bash -s -- ${verb}" < "$BUNDLED_KIT" 2>&1)"; then
      record_target "$host"
      printf '%s\n' "$out"
      return 0
    fi
    rc=$?
    if printf '%s\n' "$out" | /usr/bin/grep -q 'result=wrong-host'; then
      printf '%s\n' "$out"
      return 78
    fi
    if [ "$rc" -eq 255 ]; then
      continue
    fi
    record_target "$host"
    printf '%s\n' "$out"
    return "$rc"
  done
  return "$rc"
}

inline_remote() {
  local verb="$1"
  cat <<EOF
set -euo pipefail
PATH=/usr/bin:/bin:/usr/sbin:/sbin
hn=\$(/usr/sbin/scutil --get LocalHostName)
if [ "\$hn" != "Rico" ]; then
  echo "rico-repair: abort: LocalHostName=\$hn (required: Rico)" >&2
  echo "host=\$hn"
  echo "result=wrong-host"
  exit 78
fi
echo "host=\$hn"
echo "fallback=inline"
case "${verb}" in
  identity)
    echo "uptime=\$(/usr/bin/uptime)"
    echo "who=\$(/usr/bin/id -un)"
    echo "date=\$(/bin/date -u +%Y-%m-%dT%H:%M:%SZ)"
    ;;
  probe-healthz)
    if /usr/bin/curl -sS -m 5 --noproxy '*' http://127.0.0.1:18789/healthz | /usr/bin/grep -q live; then
      echo healthz=live
    else
      echo healthz=down
      exit 1
    fi
    ;;
  restart-gateway)
    uid=\$(/usr/bin/id -u)
    if [ "\$uid" != 501 ]; then
      echo "result=wrong-uid"
      exit 78
    fi
    if ! /bin/launchctl print gui/501/ai.openclaw.gateway >/dev/null 2>&1; then
      echo gateway_label=missing
      echo result=missing-label
      exit 1
    fi
    /bin/launchctl kickstart -k gui/501/ai.openclaw.gateway
    /bin/sleep 3
    if /usr/bin/curl -sS -m 5 --noproxy '*' http://127.0.0.1:18789/healthz | /usr/bin/grep -q live; then
      echo healthz=live
      echo result=ok
    else
      echo healthz=down
      echo result=still-down
      exit 1
    fi
    ;;
  grokbot-status)
    echo grokbot_app=/Applications/Grok Bot.app
    if [ ! -d "/Applications/Grok Bot.app" ]; then
      echo grokbot_installed=no
      echo grokbot=missing
      echo result=not-installed
      exit 1
    fi
    if /usr/bin/pgrep -f '/Applications/Grok Bot.app/' >/dev/null 2>&1 || /usr/bin/pgrep -f '/Library/Application Support/Grok Bot' >/dev/null 2>&1; then
      echo grokbot=running
    else
      echo grokbot=missing
      exit 1
    fi
    ;;
  restart-grokbot)
    echo grokbot_app=/Applications/Grok Bot.app
    echo action=restart-grokbot
    if [ ! -d "/Applications/Grok Bot.app" ]; then
      echo grokbot_installed=no
      echo result=not-installed
      exit 1
    fi
    if /usr/bin/pgrep -f '/Applications/Grok Bot.app/' >/dev/null 2>&1 || /usr/bin/pgrep -f '/Library/Application Support/Grok Bot' >/dev/null 2>&1; then
      /usr/bin/pkill -TERM -f '/Applications/Grok Bot.app/' >/dev/null 2>&1 || true
      /usr/bin/pkill -TERM -f '/Library/Application Support/Grok Bot' >/dev/null 2>&1 || true
      /bin/sleep 3
      /usr/bin/pkill -KILL -f '/Applications/Grok Bot.app/' >/dev/null 2>&1 || true
      /usr/bin/pkill -KILL -f '/Library/Application Support/Grok Bot' >/dev/null 2>&1 || true
      echo grokbot_quit=ok
    else
      echo grokbot_quit=not-running
    fi
    /usr/bin/open -a "/Applications/Grok Bot.app"
    /bin/sleep 3
    if /usr/bin/pgrep -f '/Applications/Grok Bot.app/' >/dev/null 2>&1 || /usr/bin/pgrep -f '/Library/Application Support/Grok Bot' >/dev/null 2>&1; then
      echo grokbot=running
      echo result=ok
    else
      echo grokbot=missing
      echo result=open-failed
      exit 1
    fi
    ;;
  probe-lmstudio)
    if /usr/sbin/lsof -nP -iTCP:1234 -sTCP:LISTEN 2>/dev/null | /usr/bin/grep -q '127.0.0.1:1234' || /usr/bin/pgrep -x llmster >/dev/null 2>&1; then
      echo lmstudio_alive=yes
    else
      echo lmstudio_alive=no
      echo lmstudio=dead
      exit 1
    fi
    ;;
  disk)
    /bin/df -h / | /usr/bin/awk 'NR==2 {print "disk_root="\$0}'
    ;;
  *)
    echo "result=no-inline-fallback"
    exit 127
    ;;
esac
EOF
}

rico_ssh_inline() {
  local verb="$1"
  local host rc=1 out="" script
  script="$(inline_remote "$verb")"
  for host in "${TARGETS[@]}"; do
    log "ssh ${host} inline ${verb}"
    if out="$(ssh_to "$host" "bash -s" <<< "$script" 2>&1)"; then
      record_target "$host"
      printf '%s\n' "$out"
      return 0
    fi
    rc=$?
    if printf '%s\n' "$out" | /usr/bin/grep -q 'result=wrong-host'; then
      printf '%s\n' "$out"
      return 78
    fi
    if [ "$rc" -eq 255 ]; then
      continue
    fi
    record_target "$host"
    printf '%s\n' "$out"
    return "$rc"
  done
  return "$rc"
}

rico_remote() {
  local verb="$1"
  local out rc=0
  if ! allowlisted_verb "$verb"; then
    die "refuse: verb not allowlisted" 2
  fi
  if is_test; then
    printf 'host=Rico\nfallback=test\nverb=%s\n' "$verb"
    return 0
  fi
  require_key
  if out="$(rico_ssh_named_kit "$verb")"; then
    printf '%s\n' "$out"
    return 0
  fi
  rc=$?
  if [ "$rc" -eq 78 ]; then
    printf '%s\n' "$out"
    return 78
  fi
  if [ "$rc" -ne 127 ] && [ "$rc" -ne 255 ]; then
    printf '%s\n' "$out"
    return "$rc"
  fi
  log "named kit missing or unreachable; trying bundled kit"
  if out="$(rico_ssh_piped_kit "$verb")"; then
    printf '%s\n' "$out"
    return 0
  fi
  rc=$?
  if [ "$rc" -eq 78 ]; then
    printf '%s\n' "$out"
    return 78
  fi
  if [ "$rc" -ne 127 ] && [ "$rc" -ne 255 ]; then
    printf '%s\n' "$out"
    return "$rc"
  fi
  log "bundled kit unavailable; using inline allowlisted fallback"
  rico_ssh_inline "$verb"
}

acquire_lock() {
  ensure_dirs
  if /bin/mkdir "$LOCK_DIR" 2>/dev/null; then
    printf '%s\n' "$$" > "${LOCK_DIR}/pid"
    return 0
  fi
  local old
  old="$(/bin/cat "${LOCK_DIR}/pid" 2>/dev/null || true)"
  if [ -n "$old" ] && ! /bin/kill -0 "$old" 2>/dev/null; then
    log "stale lock pid=${old}; replacing"
    /bin/rm -rf "$LOCK_DIR"
    /bin/mkdir "$LOCK_DIR"
    printf '%s\n' "$$" > "${LOCK_DIR}/pid"
    return 0
  fi
  log "watch already running; skip overlapping tick"
  return 1
}

release_lock() {
  /bin/rm -rf "$LOCK_DIR" 2>/dev/null || true
}

cmd_status() {
  local out
  echo "hop=${HOP_REQUIRED}"
  out="$(rico_remote status)" || true
  printf '%s\n' "$out"
  state_set last_poll_at "$(now_iso)"
  state_set last_healthz "$(kv_get "$out" healthz)"
  state_set last_grokbot "$(kv_get "$out" grokbot)"
  state_set last_lmstudio "$(kv_get "$out" lmstudio)"
}

maybe_act() {
  local action="$1"
  local reason="$2"
  if ! cooldown_ok "$action"; then
    log "cooldown skip ${action} (${reason})"
    return 0
  fi
  log "run ${action} (${reason})"
  local out rc=0
  out="$(rico_remote "$action")" || rc=$?
  printf '%s\n' "$out"
  mark_cooldown "$action"
  state_set "last_${action}_result" "$(kv_get "$out" result)"
  return "$rc"
}

cmd_watch_once() {
  if ! acquire_lock; then
    return 0
  fi
  trap release_lock EXIT
  local out healthz grokbot alive problems actions
  out="$(rico_remote status)" || true
  printf '%s\n' "$out"
  state_set last_poll_at "$(now_iso)"
  if ! printf '%s\n' "$out" | /usr/bin/grep -q '^host=Rico$'; then
    write_alert "$(printf '%s\n' \
      "status=ALERT" \
      "at=$(now_iso)" \
      "hop=${HOP_REQUIRED}" \
      "problem=no-rico-status" \
      "detail=hop could not prove LocalHostName=Rico; no repair run" \
      "actions=none")"
    release_lock
    trap - EXIT
    return 1
  fi
  healthz="$(kv_get "$out" healthz)"
  grokbot="$(kv_get "$out" grokbot)"
  alive="$(kv_get "$out" lmstudio_alive)"
  state_set last_healthz "$healthz"
  state_set last_grokbot "$grokbot"
  state_set last_lmstudio_alive "$alive"
  problems=""
  actions=""
  if [ "$healthz" != "live" ]; then
    problems="${problems} healthz=${healthz:-down}"
    actions="${actions} restart-gateway"
  fi
  if [ "$grokbot" != "running" ]; then
    problems="${problems} grokbot=${grokbot:-missing}"
    actions="${actions} restart-grokbot"
  fi
  if [ "$alive" = "no" ]; then
    problems="${problems} lmstudio=dead"
    actions="${actions} restart-lmstudio"
  fi
  problems="${problems# }"
  actions="${actions# }"
  if [ -z "$problems" ]; then
    log "ok healthz=live grokbot=running lmstudio_alive=${alive:-yes}"
    clear_alert
    release_lock
    trap - EXIT
    return 0
  fi
  write_alert "$(printf '%s\n' \
    "status=ALERT" \
    "at=$(now_iso)" \
    "hop=${HOP_REQUIRED}" \
    "healthz=${healthz:-unknown}" \
    "grokbot=${grokbot:-unknown}" \
    "lmstudio_alive=${alive:-unknown}" \
    "problems=${problems}" \
    "actions=${actions}" \
    "next=Goon: cat ${ALERT_FILE} ; rico-repair already invoked for matching actions if cooldown allows")"
  if [ "$healthz" != "live" ]; then
    maybe_act restart-gateway "healthz=${healthz:-down}" || true
  fi
  if [ "$grokbot" != "running" ]; then
    maybe_act restart-grokbot "grokbot=${grokbot:-missing}" || true
  fi
  if [ "$alive" = "no" ]; then
    maybe_act restart-lmstudio "lmstudio process dead" || true
  fi
  release_lock
  trap - EXIT
}

cmd_watch() {
  log "watch loop interval=${WATCH_INTERVAL}s cooldown=${COOLDOWN_SECONDS}s"
  while true; do
    cmd_watch_once || true
    /bin/sleep "$WATCH_INTERVAL"
  done
}

cmd_self_check() {
  local failed=0
  echo "rico-repair self-check"
  if [ ! -x "$0" ]; then
    echo "FAIL hop not executable"
    failed=1
  else
    echo "ok hop executable"
  fi
  if [ ! -f "$BUNDLED_KIT" ]; then
    echo "FAIL bundled kit missing"
    failed=1
  else
    echo "ok bundled kit present"
  fi
  if command -v bash >/dev/null; then
    if bash -n "$0" && bash -n "$BUNDLED_KIT"; then
      echo "ok bash -n"
    else
      echo "FAIL bash -n"
      failed=1
    fi
  fi
  echo "ssh key path: ${SSH_KEY} (never commit; no passphrase in files)"
  echo "targets: ${TARGETS[*]}"
  echo "remote kit: ${REMOTE_KIT}"
  echo "log: ${LOG_FILE}"
  echo "alert flag: ${ALERT_FILE}"
  echo "alert copy: ${ALERT_LOG_COPY}"
  echo "state: ${STATE_FILE}"
  echo "interval: ${WATCH_INTERVAL}s (LaunchAgent StartInterval 600)"
  echo "grokbot pin: /Applications/Grok Bot.app (com.anysphere.sand, verified on Rico and Rico 2)"
  if [ -x "${HERE}/rico-repair-peer" ]; then
    echo "ok peer script present"
  else
    echo "FAIL peer script missing"
    failed=1
  fi
  return "$failed"
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    status)
      require_hop_host
      cmd_status
      ;;
    restart-gateway)
      require_hop_host
      rico_remote restart-gateway
      ;;
    restart-grokbot|wake-desktop)
      require_hop_host
      rico_remote restart-grokbot
      ;;
    restart-grokbot-peer|restart-grokbot-on-rico2)
      require_origin_host
      if [ ! -x "${HERE}/rico-repair-peer" ]; then
        die "peer script missing: ${HERE}/rico-repair-peer" 1
      fi
      "${HERE}/rico-repair-peer" restart-grokbot-on-rico2
      ;;
    restart-lmstudio)
      require_hop_host
      rico_remote restart-lmstudio
      ;;
    watch-once)
      require_hop_host
      cmd_watch_once
      ;;
    watch)
      require_hop_host
      cmd_watch
      ;;
    self-check)
      cmd_self_check
      ;;
    ""|-h|--help|help)
      usage
      ;;
    *)
      echo "unknown command: ${cmd}" >&2
      usage
      ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
