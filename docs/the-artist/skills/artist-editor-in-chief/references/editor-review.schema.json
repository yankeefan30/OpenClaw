{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-artist.local/schemas/editor-review.schema.json",
  "title": "The Artist editor-in-chief review",
  "type": "object",
  "required": ["editor_review"],
  "properties": {
    "editor_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_score_out_of_10", "board_readiness", "top_strengths",
        "critical_issues_found", "slides_revised", "unresolved_questions",
        "final_recommendation"
      ],
      "properties": {
        "overall_score_out_of_10": { "type": "number", "minimum": 0, "maximum": 10 },
        "board_readiness": { "enum": ["ready", "ready_with_assumptions", "not_ready"] },
        "top_strengths": { "type": "array", "items": { "type": "string" } },
        "critical_issues_found": { "type": "array", "items": { "type": "string" } },
        "slides_revised": { "type": "array", "items": { "type": "string" } },
        "unresolved_questions": { "type": "array", "items": { "type": "string" } },
        "final_recommendation": { "type": "string" }
      }
    }
  }
}
