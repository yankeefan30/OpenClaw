{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/executive-political-health-daily-v1.json",
  "title": "ExecutivePoliticalHealthDailyPayload",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "analysis_date",
    "data_window",
    "source_coverage",
    "overall_assessment",
    "analysis_metadata"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "analysis_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "data_window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "source_coverage": { "type": "number", "minimum": 0, "maximum": 100 },
    "overall_assessment": { "type": "object" },
    "people": { "type": "array", "items": { "type": "object" } },
    "dimension_scores": { "type": "array", "items": { "type": "object" } },
    "relationship_assessments": { "type": "array", "items": { "type": "object" } },
    "interactions": { "type": "array", "items": { "type": "object" } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["external_key", "redacted_evidence_snippet", "confidence"],
        "properties": {
          "redacted_evidence_snippet": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "risks_and_opportunities": { "type": "array", "items": { "type": "object" } },
    "actions": { "type": "array", "items": { "type": "object" } },
    "review_flags": { "type": "array", "items": { "type": "object" } },
    "analysis_metadata": {
      "type": "object",
      "required": [
        "analyst_version",
        "claude_model_or_skill_version",
        "analysis_timestamp",
        "timezone"
      ],
      "properties": {
        "timezone": { "const": "America/New_York" }
      }
    }
  },
  "additionalProperties": true,
  "description": "Canonical runtime validation is Zod DailyPayloadSchema in src/schemas/payload.ts. This JSON Schema is a contract overview for upstream producers."
}
